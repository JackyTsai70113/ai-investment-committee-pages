    },
    {
      "evidence_id": "official-b33ea29d21403dc04fa464cf55a448e5",
      "source_url": "https://www.bea.gov/news/2026/personal-income-and-outlays-july-2026",
      "published_at": null,
      "available_at": "2026-09-15T16:00:30Z",
      "retrieval": {
        "document_id": "5895968b941e893ae940f010268634dd017bbc4c4058557676a7d36a9b08e05d",
        "content_hash": "131a34937193d5631ac80c606ab233febeb7cbbb267ac6ccdaf9a091a9fee9f7",
        "source_query": "https://www.bea.gov/news/current-releases",
        "source_type": "macro_release",
        "authority": "official",
        "retrieved_at": "2026-09-15T17:58:16.191040Z",
        "publication_date": "2026-08-26",
        "publication_precision": "date",
        "available_at": "2026-09-15T16:00:30Z",
        "content_locator": "已讀 HTML 全文；換行分隔文字節點",
        "excerpt": "Personal income\nincreased $115.1 billion\n(0.4 percent at a monthly rate) in July, according to estimates released today by the U.S. Bureau of Economic Analysis (BEA).\nDisposable personal income (DPI)\n—personal income less personal current taxes—increased $125.9 billion (0.5 percent), and\npersonal consumption expenditures (PCE)\nincreased $36.3 billion (0.2 percent).\nPersonal outlays\n—the sum of PCE, personal interest payments, and personal current transfer payments—increased $36.6 billion in July.\nPersonal saving\nwas $712.0 billion in July, and the\npersonal saving rate\n—personal saving as a percentage of DPI—was 3.0 percent.\n",
        "claim_kind": "fact",
        "source_status": "revised"
      },
      "symbols": [
        "AVGO",
        "CASH",
        "GLD",
        "META",
        "NVDA",
        "PLTR"
      ],
      "summary": "文件指出：2026 年 7 月個人所得增加 1151 億美元（月增率 0.4%）；可支配個人所得增加 1259 億美元（0.5%）；PCE 增加 363 億美元（0.2%）。同期 PCE 價格指數月增 0.2%，不含食品與能源亦月增 0.2%；與去年同月相比 PCE 價格指數上升 3.7%，不含食品與能源上升 3.3%。",
      "market_relevance": "消費支出與通膨相關的價格指數（PCE price index）可影響通膨預期、利率預期與消費需求評估。",
      "interpretation": "untrusted_observation"
    },
